#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

output=${1:?usage: scripts/package OUTPUT_DIRECTORY}
repo=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
mkdir -p "$output"
output=$(CDPATH='' cd "$output" && pwd -P)
version=$(cat "$repo/RELEASE_VERSION")
printf '%s\n' "$version" | awk '/^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$/ {ok=1} END {exit !ok}' || { echo 'Invalid RELEASE_VERSION' >&2; exit 1; }
release=${SESSIONBUS_STATUS_RELEASE:-development}
case "$release" in development|"v$version") ;; *) echo 'Release must match RELEASE_VERSION' >&2; exit 1;; esac
revision=${SESSIONBUS_STATUS_REVISION:-$(git -C "$repo" rev-parse HEAD)}
if [ "${#revision}" -ne 40 ] || printf '%s' "$revision" | LC_ALL=C grep -q '[^0-9a-f]'; then
  echo 'Invalid revision' >&2; exit 1
fi
goos=${GOOS:-$(go env GOOS)}
goarch=${GOARCH:-$(go env GOARCH)}
case "$goos/$goarch" in linux/amd64|linux/arm64|darwin/amd64|darwin/arm64) ;; *) echo 'Unsupported target' >&2; exit 1;; esac
stage=$(mktemp -d)
trap 'rm -rf "$stage"' 0
trap 'exit 1' HUP INT TERM
(cd "$repo" && CGO_ENABLED=0 GOOS="$goos" GOARCH="$goarch" go build -trimpath -ldflags "-s -w -X main.release=$release -X main.revision=$revision" -o "$stage/sessionbus-status" .)
cp "$repo/scripts/archive-install" "$stage/install"
cp "$repo/LICENSE" "$repo/README.md" "$repo/scripts/THIRD-PARTY-NOTICES.txt" "$stage/"
printf 'sessionbus-status\n' > "$stage/ROLE"
printf '%s\n' "$revision" > "$stage/SOURCE.txt"
archive="$output/sessionbus-status-$goos-$goarch.tar.gz"
tar -czf "$archive" -C "$stage" sessionbus-status install ROLE SOURCE.txt LICENSE README.md THIRD-PARTY-NOTICES.txt
printf '%s\n' "$archive"
